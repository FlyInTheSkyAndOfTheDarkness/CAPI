# Шаблон сайта nginx для CAPI (docker-compose.server.yml).
# Подставьте домен и положите в /etc/nginx/sites-available:
#   sed 's/__DOMAIN__/capi.garden/g' deploy/nginx-site.conf.template \
#     | sudo tee /etc/nginx/sites-available/capi.garden.conf
# HTTPS добавит certbot: sudo certbot --nginx -d __DOMAIN__ -d www.__DOMAIN__
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8095;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
